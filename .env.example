# ── Pick ONE backend ──────────────────────────────────────────────
# Free, uses your existing Claude Code subscription (recommended):
#   npm install -g @anthropic-ai/claude-code && claude login
KUBAKA_BACKEND=claude_cli

# Free tier, no credit card — get a key at aistudio.google.com/apikey
# KUBAKA_BACKEND=gemini
# GOOGLE_API_KEY=

# Paid Anthropic API
# KUBAKA_BACKEND=anthropic
# ANTHROPIC_API_KEY=
